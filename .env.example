# Скопируйте в .env и заполните. .env в git не попадает.

# Fine-grained PAT с правом Contents: Read and write на репозиторий gitops-main.
# Нужен Kargo, чтобы коммитить новые теги образов в envs/<stage>.
GITHUB_TOKEN=
GITHUB_USER=PonamaryovMV

# Необязательно — значения по умолчанию:
# CLUSTER_NAME=gitops-stand
# GITHUB_OWNER=PonamaryovMV


# Kubeconfig для Lens на Windows (только при запуске из WSL):
#   auto — писать %USERPROFILE%\.kube\gitops-stand.yaml
#   off  — ничего не трогать в Windows
# WINDOWS_KUBECONFIG=auto
# true — ещё и добавить контекст kind-gitops-stand в %USERPROFILE%\.kube\config (с бэкапом)
# WINDOWS_KUBECONFIG_MERGE=true

# Пути к соседним репозиториям (по умолчанию ../infra, ../gitops-infra, ../gitops-main)
# INFRA_DIR=
# GITOPS_INFRA_DIR=
# GITOPS_MAIN_DIR=
